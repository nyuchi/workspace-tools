---
/**
 * Base — the html shell shared by every route, on the apps/nyuchi pattern
 * (bundu-labs/marketing): theme bootstrap, fonts, sticky header, footer,
 * breadcrumb trail auto-derived by @bundu/ui, the global stylesheet
 * (@bundu/ui tokens + Tailwind), and per-page meta through props.
 *
 * Tools-site theme convention (unchanged from the live site): localStorage
 * `nyuchi-theme`, attribute `data-theme`, default dark. The sticky header is
 * 4rem tall — the tool islands' sticky side panels assume `top: 4rem`.
 */
import '../styles/global.css'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import Breadcrumb from '@bundu/ui/Breadcrumb.astro'
import MineralStrip from '@bundu/ui/MineralStrip.astro'
import { deriveBreadcrumbs, type BreadcrumbItem, type BreadcrumbLabelMap } from '@bundu/ui'

interface Props {
  title: string
  description?: string
  noIndex?: boolean
  hideHeader?: boolean
  hideFooter?: boolean
  hideBreadcrumb?: boolean
  /** Override the auto-derived breadcrumb trail. */
  breadcrumbs?: BreadcrumbItem[]
  /** Auto-derive helper: label for the current page when dynamic. */
  breadcrumbCurrentName?: string
}

/** Tools-site route → display-name map (null hides routing tokens). */
const TOOLS_BREADCRUMB_LABELS: BreadcrumbLabelMap = {
  'signature-generator': 'Signature',
  studio: 'Studio',
  'gmail-addon': 'Gmail Add-on',
  setup: 'Setup',
  help: 'Help',
}

const {
  title,
  description = 'Email signature management and brand design tools for Nyuchi Africa and the Bundu ecosystem — signatures, Nyuchi Studio social cards, and an MCP server for AI agents.',
  noIndex = false,
  hideHeader = false,
  hideFooter = false,
  hideBreadcrumb = false,
  breadcrumbs,
  breadcrumbCurrentName,
} = Astro.props

const breadcrumbTrail =
  breadcrumbs ??
  deriveBreadcrumbs(
    Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, ''),
    TOOLS_BREADCRUMB_LABELS,
    'nyuchi',
    breadcrumbCurrentName,
  )

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const fullTitle = title.toLowerCase().includes('nyuchi') ? title : `${title} | nyuchi workspace tools`
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      href="https://assets.nyuchi.com/logos/nyuchi/Nyuchi_Africa_Logo_icon.svg"
      type="image/svg+xml"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="nyuchi workspace tools" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      /* Theme before first paint: localStorage `nyuchi-theme`, default dark. */
      ;(function () {
        var theme = 'dark'
        try {
          if (localStorage.getItem('nyuchi-theme') === 'light') theme = 'light'
        } catch (_) {
          /* storage unavailable → default dark */
        }
        document.documentElement.setAttribute('data-theme', theme)
      })()
    </script>
  </head>

  <body class="min-h-dvh flex flex-col bg-background text-foreground font-sans antialiased">
    {!hideHeader && <MineralStrip aria-hidden="true" />}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-background focus:text-foreground focus:rounded-md focus:shadow-md focus:border focus:border-border"
    >
      Skip to content
    </a>
    {!hideHeader && <Header />}

    <main id="main" class="flex-1">
      {!hideBreadcrumb && (
        <Breadcrumb
          items={breadcrumbTrail}
          origin="https://tools.nyuchi.com"
          class="container-custom pt-6 pb-2"
        />
      )}
      <slot />
    </main>

    {!hideFooter && <Footer />}
  </body>
</html>
