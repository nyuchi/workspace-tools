{
  "name": "workspace-tools",
  "version": "2.0.0",
  "description": "Nyuchi workspace tools - Gmail Add-on, email signature generator, Nyuchi Studio, and the nyuchi-tools Cloudflare Worker (SPA + MCP)",
  "private": true,
  "workspaces": [
    "gmail-addon",
    "email-signature"
  ],
  "scripts": {
    "push:gmail": "cd gmail-addon && clasp push",
    "push:signature": "cd email-signature && clasp push",
    "push:all": "npm run push:gmail && npm run push:signature",
    "open:gmail": "cd gmail-addon && clasp open",
    "open:signature": "cd email-signature && clasp open",
    "deploy:gmail": "cd gmail-addon && clasp deploy",
    "deploy:signature": "cd email-signature && clasp deploy",
    "build:web": "npm run build --prefix signature-generator",
    "dev:tools": "wrangler dev",
    "deploy:tools": "wrangler deploy",
    "typecheck:worker": "tsc --noEmit -p mcp/tsconfig.json",
    "test": "npm --prefix signature-generator test && npm run test:worker",
    "test:worker": "vp test run -c vitest.worker.config.ts",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "ci:check": "vp lint",
    "ci:test": "npm run test:worker"
  },
  "keywords": [
    "google-workspace",
    "gmail-addon",
    "email-signature",
    "admin-dashboard",
    "nyuchi",
    "nyuchi-africa"
  ],
  "author": {
    "name": "Nyuchi Web Services",
    "url": "https://services.nyuchi.com"
  },
  "contributors": [
    {
      "name": "Bryan Fawcett",
      "email": "bryan@nyuchi.com"
    }
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/nyuchi/workspace-tools.git"
  },
  "bugs": {
    "url": "https://github.com/nyuchi/workspace-tools/issues"
  },
  "homepage": "https://github.com/nyuchi/workspace-tools#readme",
  "dependencies": {
    "@braintree/sanitize-url": ">=7.1.2",
    "@modelcontextprotocol/server": ">=2.4.0",
    "@resvg/resvg-wasm": ">=2.6.2",
    "hono": ">=4.13.17",
    "jose": ">=6.2.15",
    "zod": ">=4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": ">=5.20261108.1",
    "@google/clasp": ">=3.4.1",
    "@modelcontextprotocol/client": ">=2.4.0",
    "@types/google-apps-script": ">=2.0.15",
    "@types/node": ">=26.6.6",
    "typescript": ">=7.0.2",
    "vite-plus": ">=1.5.0",
    "vitest": ">=5.1.0",
    "wrangler": ">=4.158.0"
  },
  "packageManager": "npm@11.12.1",
  "overrides": {
    "@google/clasp": {
      "zod": ">=4.6.7"
    },
    "body-parser": ">=2.4.0",
    "proxy-addr": ">=2.0.8",
    "sharp": ">=0.35.5",
    "undici@>=7.0.0 <7.30.1": ">=7.30.1",
    "uuid": ">=11.1.1",
    "vite@>=8.0.0 <8.3.5": ">=8.3.5"
  }
}
