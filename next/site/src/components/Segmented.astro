---
/**
 * Segmented control (Mzizi `segmented-control`): a radio group drawn as a
 * pill track. Native radios, so keyboard (arrow keys) and screen readers
 * work with no script; the visible segment is the label.
 */
interface Props {
  name: string
  legend: string
  options: [string, string][]
  value: string
  hideLegend?: boolean
  size?: 'sm' | 'md'
}
const { name, legend, options, value, hideLegend = false, size = 'md' } = Astro.props
const h = size === 'sm' ? 'min-h-10 px-3 text-body-sm' : 'min-h-12 px-4 text-body-sm'
---

<fieldset class="min-w-0">
  <legend class={hideLegend ? 'sr-only' : 'block text-body-sm font-medium text-foreground mb-1.5'}>{legend}</legend>
  <div class="inline-flex max-w-full flex-wrap gap-1 rounded-full border border-border bg-muted p-1">
    {
      options.map(([v, l]) => (
        <label class="relative cursor-pointer">
          <input type="radio" name={name} value={v} checked={v === value} class="peer sr-only" />
          <span
            class={`${h} inline-flex items-center justify-center rounded-full font-medium text-foreground/80 transition-colors duration-200 ease-soft hover:text-foreground peer-checked:bg-card peer-checked:text-foreground peer-checked:shadow-sm peer-focus-visible:ring-2 peer-focus-visible:ring-ring peer-focus-visible:ring-offset-2 peer-focus-visible:ring-offset-background`}
          >
            {l}
          </span>
        </label>
      ))
    }
  </div>
</fieldset>
