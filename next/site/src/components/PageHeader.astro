---
// TODO(mzizi): replace with @bundu/ui PageHeader (https://github.com/mzizi-dev/packages-npm/pull/18).
/** Page header (Mzizi `page-header`): eyebrow, serif title, lead, and an
    actions slot that wraps under the text on small screens. */
interface Props {
  eyebrow?: string
  title: string
  description?: string
}
const { eyebrow, title, description } = Astro.props
---

<header class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
  <div class="min-w-0 max-w-3xl">
    {eyebrow && <p class="text-caption font-semibold uppercase tracking-[0.12em] text-primary">{eyebrow}</p>}
    <h1 class="mt-1 font-serif text-h2 text-foreground text-balance">{title}</h1>
    {description && <p class="mt-2 text-body text-foreground/80 text-pretty">{description}</p>}
  </div>
  <div class="flex shrink-0 flex-wrap gap-2 whitespace-nowrap"><slot name="actions" /></div>
</header>
