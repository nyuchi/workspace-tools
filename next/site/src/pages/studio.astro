---
import Base from '../layouts/Base.astro'
import Section from '@bundu/ui/Section.astro'
import SectionHeader from '@bundu/ui/SectionHeader.astro'
import { presets, themes, GROUPS } from '../lib/data'

const DEFAULTS = new Set(['story', 'square', 'og', 'cws-screenshot'])
const field = 'w-full rounded-[14px] border border-border bg-background px-4 py-3 text-body min-h-[48px] focus:outline-none focus:ring-2 focus:ring-gold'
const label = 'block text-body-sm font-medium mb-2'
---

<Base title="Studio" description="One screenshot and a headline in; a whole launch set out.">
  <Section>
    <SectionHeader
      eyebrow="Images"
      title="Studio"
      description="One screenshot and a headline in; a whole set out. Preview each size with its platform's safe area, then download the set with alt text for every image."
      as="h1"
      size="h1"
    />

    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,420px)_1fr]">
      <form id="studio" class="space-y-6" novalidate>
        <div>
          <label class={label} for="headline">Headline</label>
          <input class={field} id="headline" name="headline" required value="Every criterion, in its own column." />
        </div>
        <div>
          <label class={label} for="eyebrow">Eyebrow</label>
          <input class={field} id="eyebrow" name="eyebrow" placeholder="The theme's default" />
        </div>
        <div>
          <label class={label} for="sub">Supporting line</label>
          <textarea class={field} id="sub" name="sub" rows="2"></textarea>
        </div>
        <div>
          <label class={label} for="points">Points <span class="text-muted-foreground font-normal">(one per line; stories and square)</span></label>
          <textarea class={field} id="points" name="points" rows="3"></textarea>
        </div>
        <div>
          <label class={label} for="cta">Call to action</label>
          <input class={field} id="cta" name="cta" placeholder="learning.nyuchi.com" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class={label} for="theme">Theme</label>
            <select class={field} id="theme" name="theme">
              {themes.map((t) => <option value={t.id}>{t.name}</option>)}
            </select>
          </div>
          <div>
            <label class={label} for="mode">Mode</label>
            <select class={field} id="mode" name="mode">
              <option value="light">Light</option>
              <option value="dark">Dark</option>
            </select>
          </div>
        </div>

        <fieldset class="rounded-[14px] border border-border p-4 space-y-4">
          <legend class="px-2 text-body-sm font-medium">Screenshot (optional)</legend>
          <input class="block w-full text-body-sm min-h-[44px]" type="file" id="image" name="image" accept="image/png,image/jpeg" />
          <div>
            <label class={label} for="alt">What it shows <span class="text-muted-foreground font-normal">(becomes the alt text)</span></label>
            <input class={field} id="alt" name="alt" placeholder="The gradebook with fake students, one column per criterion" />
          </div>
          <div>
            <label class={label} for="chrome">Browser frame address</label>
            <input class={field} id="chrome" name="chrome" placeholder="Leave empty for a plain card" />
          </div>
          <label class="flex items-start gap-3 text-body-sm min-h-[44px]">
            <input type="checkbox" id="attest" name="attest" class="mt-1 h-5 w-5" />
            <span>
              This screenshot shows only <strong>fake or redacted</strong> data: no real student, staff or school names, IDs,
              emails or photos, and no school name.
            </span>
          </label>
        </fieldset>

        <fieldset class="rounded-[14px] border border-border p-4">
          <legend class="px-2 text-body-sm font-medium">Sizes</legend>
          {
            GROUPS.map((g) => (
              <div class="mt-2">
                <p class="text-caption uppercase tracking-wider text-muted-foreground">{g.label}</p>
                <div class="mt-1 grid grid-cols-1 sm:grid-cols-2 gap-x-4">
                  {presets
                    .filter((p) => p.group === g.id)
                    .map((p) => (
                      <label class="flex items-center gap-3 text-body-sm min-h-[44px]">
                        <input type="checkbox" name="preset" value={p.id} checked={DEFAULTS.has(p.id)} class="h-5 w-5" />
                        <span>
                          {p.name} <span class="text-muted-foreground font-mono">{p.width}×{p.height}</span>
                        </span>
                      </label>
                    ))}
                </div>
              </div>
            ))
          }
          <label class="flex items-center gap-3 text-body-sm min-h-[44px] mt-3 border-t border-border pt-3">
            <input type="checkbox" id="guides" class="h-5 w-5" />
            <span>Show safe-area guides in the preview</span>
          </label>
        </fieldset>

        <div class="flex flex-wrap gap-3">
          <button type="submit" class="rounded-full bg-foreground text-background px-6 min-h-[48px] font-medium hover:opacity-90">Preview</button>
          <button type="button" id="download" class="rounded-full border border-border px-6 min-h-[48px] font-medium hover:bg-muted">Download set (.zip)</button>
        </div>
        <p id="status" class="text-body-sm text-muted-foreground" role="status" aria-live="polite"></p>
      </form>

      <div id="previews" class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3 content-start" aria-label="Previews"></div>
    </div>
  </Section>
</Base>

<script>
  const form = document.getElementById('studio') as HTMLFormElement
  const status = document.getElementById('status')!
  const previews = document.getElementById('previews')!
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim()
  const checked = (id: string) => (document.getElementById(id) as HTMLInputElement).checked

  const readImage = (): Promise<string | null> =>
    new Promise((resolve, reject) => {
      const file = (document.getElementById('image') as HTMLInputElement).files?.[0]
      if (!file) return resolve(null)
      const r = new FileReader()
      r.onload = () => resolve(String(r.result))
      r.onerror = () => reject(new Error('Could not read the screenshot.'))
      r.readAsDataURL(file)
    })

  const content = () => ({
    headline: val('headline'),
    eyebrow: val('eyebrow') || undefined,
    sub: val('sub') || undefined,
    points: val('points').split('\n').map((s) => s.trim()).filter(Boolean),
    cta: val('cta') || undefined,
  })

  const selected = () =>
    [...form.querySelectorAll<HTMLInputElement>('input[name="preset"]:checked')].map((i) => i.value)

  async function errorText(res: Response) {
    try {
      return (await res.json()).error ?? res.statusText
    } catch {
      return res.statusText
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const ids = selected()
    if (!val('headline')) return void (status.textContent = 'Add a headline.')
    if (!ids.length) return void (status.textContent = 'Pick at least one size.')
    let data: string | null
    try {
      data = await readImage()
    } catch (err) {
      return void (status.textContent = (err as Error).message)
    }
    previews.replaceChildren()
    status.textContent = `Rendering ${ids.length}…`
    let done = 0
    for (const id of ids) {
      const body = {
        preset: id,
        theme: val('theme'),
        mode: val('mode'),
        guides: checked('guides'),
        fake_or_redacted: checked('attest'),
        ...content(),
        ...(data ? { image: { data, alt: val('alt'), chrome: val('chrome') || undefined } } : {}),
      }
      const fig = document.createElement('figure')
      fig.className = 'rounded-[14px] border border-border p-3 bg-card'
      const cap = document.createElement('figcaption')
      cap.className = 'text-caption text-muted-foreground mt-2'
      const res = await fetch('/api/render', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) })
      if (res.ok) {
        const img = document.createElement('img')
        img.src = URL.createObjectURL(await res.blob())
        img.alt = decodeURIComponent(res.headers.get('x-alt-text') ?? '')
        img.className = 'w-full h-auto rounded-[8px]'
        cap.textContent = `${id} · ${res.headers.get('x-width')}×${res.headers.get('x-height')}`
        fig.append(img, cap)
      } else {
        cap.textContent = `${id}: ${await errorText(res)}`
        fig.append(cap)
      }
      previews.append(fig)
      status.textContent = `Rendered ${++done} of ${ids.length}.`
    }
  })

  document.getElementById('download')!.addEventListener('click', async () => {
    const ids = selected()
    if (!ids.length || !val('headline')) return void (status.textContent = 'Add a headline and pick at least one size.')
    let data: string | null
    try {
      data = await readImage()
    } catch (err) {
      return void (status.textContent = (err as Error).message)
    }
    status.textContent = 'Building the set…'
    const c = content()
    const campaign = {
      theme: val('theme'),
      mode: val('mode'),
      privacy: { fake_or_redacted: checked('attest') },
      content: { ...c, sub: c.sub ?? undefined },
      ...(data ? { image: { alt: val('alt'), chrome: val('chrome') || undefined } } : {}),
      render: ids.map((preset) => ({ preset })),
    }
    const res = await fetch('/api/campaign', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ campaign, image: data ?? undefined }),
    })
    if (!res.ok) return void (status.textContent = await errorText(res))
    const a = document.createElement('a')
    a.href = URL.createObjectURL(await res.blob())
    a.download = 'campaign.zip'
    a.click()
    status.textContent = 'Downloaded. Check every image at full size before publishing.'
  })
</script>
