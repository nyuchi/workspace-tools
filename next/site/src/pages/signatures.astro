---
// TODO(mzizi): the preview frame is registry mzizi-email-preview (https://github.com/mzizi-dev/mzizi-registry/pull/398); swap in its Astro port when it releases.
import Base from '../layouts/Base.astro'
import PageHeader from '../components/PageHeader.astro'
import Select from '../components/Select.astro'
import Glyph from '../components/Glyph.astro'
import { brands } from '../lib/data'
import { card, input, label, hint } from '../lib/ui'

const KIND = { foundation: 'Foundation', pillar: 'Pillar', division: 'Division', initiative: 'Initiative' } as const
const brandOptions: [string, string][] = [['', 'From my email address'], ...brands.map((b) => [b.key, `${b.name} — ${KIND[b.kind]}`] as [string, string])]
const fields: { id: string; label: string; type?: 'text' | 'email' | 'tel' | 'url'; auto?: string; hint?: string; required?: boolean; ph?: string }[] = [
  { id: 'name', label: 'Name', auto: 'name', required: true },
  { id: 'title', label: 'Role', auto: 'organization-title' },
  { id: 'email', label: 'Email', type: 'email', auto: 'email', required: true },
  { id: 'phone', label: 'Phone', type: 'tel', auto: 'tel' },
  { id: 'whatsapp', label: 'WhatsApp', type: 'tel', ph: '+263 …' },
  { id: 'linkedin', label: 'LinkedIn profile', type: 'url', ph: 'https://www.linkedin.com/in/…' },
  { id: 'photo', label: 'Photo', type: 'url', hint: 'Optional, an https:// link to a square photo.' },
]
---

<Base title="Signatures" description="The email signature on Mzizi, for every Bundu-ecosystem brand." wide>
  <div class="rise mx-auto max-w-[1600px] space-y-8">
    <PageHeader
      eyebrow="Create"
      title="Email signature"
      description="Built from tables and inline styles so it looks the same in Gmail, Outlook and Apple Mail — no images unless you add a photo."
    />

    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <form id="sig" class={`${card} space-y-5 p-5 sm:p-6`} novalidate>
        <div>
          <label class={label} for="brand">Brand</label>
          <Select id="brand" options={brandOptions} />
        </div>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          {
            fields.map((f) => (
              <div class={f.id === 'photo' || f.id === 'linkedin' ? 'sm:col-span-2' : ''}>
                <label class={label} for={f.id}>
                  {f.label}
                  {f.required && <span class="text-foreground/80"> (required)</span>}
                </label>
                <input class={input} id={f.id} name={f.id} type={f.type ?? 'text'} autocomplete={f.auto} required={f.required} placeholder={f.ph} />
                {f.hint && <p class={`${hint} mt-1.5`}>{f.hint}</p>}
              </div>
            ))
          }
        </div>
        <button type="submit" class="btn-primary w-full sm:w-auto">
          <Glyph name="sparkle" /> Preview signature
        </button>
      </form>

      <section class={`${card} p-5 sm:p-6 lg:sticky lg:top-6`} aria-labelledby="preview-h">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 id="preview-h" class="font-serif text-h4 text-foreground">Preview</h2>
          <div class="flex flex-wrap gap-2">
            <button type="button" id="copy-html" class="btn-secondary" disabled><Glyph name="copy" /> Copy for Gmail</button>
            <button type="button" id="copy-text" class="btn-outline" disabled>Plain text</button>
          </div>
        </div>
        <div class="mt-4 overflow-hidden rounded-[14px] border border-border">
          <div class="space-y-1 border-b border-border bg-muted px-4 py-3 text-body-sm text-foreground/80" aria-hidden="true">
            <p><span class="font-medium text-foreground">To:</span> a colleague</p>
            <p><span class="font-medium text-foreground">Subject:</span> Following up</p>
          </div>
          <div class="bg-white p-4 sm:p-6">
            <p class="mb-4 font-sans text-[15px] leading-relaxed text-[#1a1a17]" aria-hidden="true">Thanks for your time today — notes attached.</p>
            <!-- The message body is white in every theme, like the email it
                 stands for, so its placeholder uses email ink, not tokens. -->
            <div id="sig-empty" class="rounded-[14px] border border-dashed border-[#c9c7c0] px-6 py-8 text-center">
              <p class="font-medium text-[#1a1a17]">Your signature appears here</p>
              <p class="mt-1 text-body-sm text-[#45453f]">Fill in your details and choose Preview. Nothing is saved.</p>
            </div>
            <iframe id="preview" title="Signature preview" class="hidden w-full border-0" sandbox=""></iframe>
          </div>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  const form = document.getElementById('sig') as HTMLFormElement
  const preview = document.getElementById('preview') as HTMLIFrameElement
  const empty = document.getElementById('sig-empty')!
  const copyHtml = document.getElementById('copy-html') as HTMLButtonElement
  const copyText = document.getElementById('copy-text') as HTMLButtonElement
  const toast = (m: string, k?: string) => (window as unknown as { toast: (m: string, k?: string) => void }).toast(m, k)
  let current: { html: string; text: string } | null = null

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const body = Object.fromEntries([...new FormData(form)].map(([k, v]) => [k, String(v).trim()]))
    const res = await fetch('/api/signature', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) })
    const out = await res.json().catch(() => ({}))
    if (!res.ok) return toast(out.error ?? 'Could not build the signature.', 'error')
    current = out
    // Sandboxed: the preview can show the HTML but never run anything.
    preview.srcdoc = `<!doctype html><body style="margin:0;background:#fff">${out.html}</body>`
    preview.onload = () => {
      preview.style.height = `${(preview.contentDocument?.body.scrollHeight ?? 200) + 8}px`
    }
    preview.classList.remove('hidden')
    empty.classList.add('hidden')
    copyHtml.disabled = copyText.disabled = false
  })

  copyHtml.addEventListener('click', async () => {
    if (!current) return
    await navigator.clipboard.write([
      new ClipboardItem({
        'text/html': new Blob([current.html], { type: 'text/html' }),
        'text/plain': new Blob([current.text], { type: 'text/plain' }),
      }),
    ])
    toast('Copied. In Gmail: Settings → See all settings → Signature → paste.')
  })
  copyText.addEventListener('click', async () => {
    if (!current) return
    await navigator.clipboard.writeText(current.text)
    toast('Plain text copied.')
  })
</script>
