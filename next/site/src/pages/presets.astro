---
import Base from '../layouts/Base.astro'
import Section from '@bundu/ui/Section.astro'
import SectionHeader from '@bundu/ui/SectionHeader.astro'
import { presets, GROUPS, fmtBytes } from '../lib/data'
---

<Base title="Presets" description="Every image size nyuchi-tools renders, with platform safe areas.">
  <Section>
    <SectionHeader
      eyebrow="Reference"
      title="Presets"
      description="Every size the tools render. Safe areas are the bands a platform covers with its own interface; text and screenshots are laid out inside them. Generated from the same file the renderer reads."
      as="h1"
      size="h1"
    />
    {
      GROUPS.map((g) => (
        <div class="mt-12">
          <h2 class="font-serif text-h3">{g.label}</h2>
          <div class="mt-4 overflow-x-auto rounded-[14px] border border-border">
            <table class="w-full text-body-sm">
              <thead class="bg-muted text-left text-muted-foreground">
                <tr>
                  <th class="p-3 font-medium">Preset</th>
                  <th class="p-3 font-medium">Size</th>
                  <th class="p-3 font-medium">Format</th>
                  <th class="p-3 font-medium">Safe area (t/r/b/l)</th>
                  <th class="p-3 font-medium">Limit</th>
                  <th class="p-3 font-medium">Where</th>
                </tr>
              </thead>
              <tbody>
                {presets
                  .filter((p) => p.group === g.id)
                  .map((p) => (
                    <tr class="border-t border-border align-top">
                      <td class="p-3">
                        <code class="font-mono">{p.id}</code>
                        <div class="text-muted-foreground">{p.name}</div>
                      </td>
                      <td class="p-3 whitespace-nowrap font-mono">
                        {p.width}×{p.height}
                      </td>
                      <td class="p-3 uppercase">{p.format}</td>
                      <td class="p-3 font-mono">{p.safe.some((v) => v > 0) ? p.safe.join('/') : '—'}</td>
                      <td class="p-3 whitespace-nowrap">{fmtBytes(p.max_bytes)}</td>
                      <td class="p-3 text-muted-foreground">{p.platform}</td>
                    </tr>
                  ))}
              </tbody>
            </table>
          </div>
        </div>
      ))
    }
  </Section>
</Base>
